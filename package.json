{
  "name": "html_timeline",
  "version": "1.0.0",
  "description": "A TypeScript module that generates HTML table-based timelines using vis-timeline compatible data structures. Outputs pure HTML/CSS that displays well on web and exports cleanly to PowerPoint via pptxgenjs's `tableToSlides()`.",
  "main": "html-timeline.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephennathan/html_timeline.git"
  },
  "keywords": [],
  "author": "Steve Nathan",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/stephennathan/html_timeline/issues"
  },
  "homepage": "https://github.com/stephennathan/html_timeline#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1"
  }
}
